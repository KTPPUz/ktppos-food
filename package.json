{
  "name": "ktp-table-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-laravel.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "cd backend && php artisan serve --host=0.0.0.0 --port=5173",
    "test": "npm run test:php && npm run test:legacy",
    "test:e2e": "playwright test",
    "test:production": "node scripts/check-hostinger.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "php backend/artisan migrate",
    "db:seed": "php backend/artisan pos:seed",
    "db:import": "php backend/artisan pos:import",
    "test:db": "node --test tests/postgres.integration.test.mjs",
    "dev:legacy": "node server/index.mjs",
    "build:hostinger": "node scripts/build-hostinger.mjs",
    "test:php": "cd backend && php artisan test",
    "package:hostinger": "node scripts/package-hostinger.mjs",
    "db:export:legacy": "node scripts/export-postgres.mjs",
    "db:generate:legacy": "prisma generate",
    "db:migrate:legacy": "prisma migrate deploy",
    "db:seed:legacy": "node scripts/database.mjs seed",
    "db:import:legacy": "node scripts/database.mjs import",
    "test:production:legacy": "npm run build && node scripts/check-production.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "start:legacy": "node server/index.mjs --production"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
