# Main Laravel backend configuration is in backend/.env (see backend/.env.example).
# Local Docker MariaDB / phpMyAdmin. Set DB_PASSWORD in backend/.env to match.
MARIADB_PASSWORD=replace_with_local_database_password
MARIADB_ROOT_PASSWORD=replace_with_different_root_password

# Legacy Express/PostgreSQL configuration (only for exporting previous data):
# Server runtime variables: export these in your host's Environment settings.
# npm start uses the host's PORT; local development defaults to 5173.
# PostgreSQL: set both values below after running migrations and importing data.
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgresql://pos_food:replace_with_local_password@127.0.0.1:55432/pos_food?schema=public
# Docker Compose only (password must match DATABASE_URL).
# POSTGRES_PASSWORD=replace_with_local_password
# POSTGRES_PORT=55432
# Without STORAGE_DRIVER / DATABASE_URL, the JSON demo remains available.
HOST=0.0.0.0
PORT=5173
# DATA_DIR must be under a persistent disk on a hosted JSON demo.
DATA_DIR=/var/data/ktp-table
# One trusted reverse-proxy hop on Render. Leave 0 for direct local connections.
TRUST_PROXY=1
# No trailing path: browsers send only the origin in CORS.
CORS_ALLOWED_ORIGINS=https://ktppuz.github.io
# Optional; Render's RENDER_EXTERNAL_URL is used automatically when omitted.
# CUSTOMER_BASE_URL=https://ktppuz.github.io/ktppos-food/

# Frontend BUILD variables (Vite reads these from .env.local or build environment).
# Omit both for a complete same-origin Node/Render deployment.
# VITE_API_BASE_URL=https://your-service.onrender.com/api
# VITE_BASE_PATH=/ktppos-food/
