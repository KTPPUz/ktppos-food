APP_NAME="KTP Table"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_hostinger_database
DB_USERNAME=your_hostinger_user
DB_PASSWORD=replace_with_database_password
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Optional public URL for customer QR codes.
# CUSTOMER_BASE_URL=https://your-domain.com
# Only needed for a frontend served on a different origin.
CORS_ALLOWED_ORIGINS=
